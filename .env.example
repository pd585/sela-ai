# -----------------------------------------------------------------------------
# SELA ENVIRONMENT CONFIGURATION TEMPLATE
# -----------------------------------------------------------------------------

# --- SUPABASE CONFIGURATION ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- APPLICATION URL ---
APP_URL=http://localhost:3000

# --- AI LLM PROVIDER CONFIGURATION ---
AI_LLM_PRIMARY_PROVIDER=gemini
AI_LLM_FALLBACK_PROVIDERS=openrouter,ollama

# Google Gemini Direct
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-2.5-flash

# OpenRouter Fallback
OPENROUTER_API_KEY=
OPENROUTER_LLM_MODEL=google/gemini-2.5-flash

# Ollama Optional Local Fallback
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.2

# --- EMBEDDING ENGINE CONFIGURATION (Strict 3072-Dimensional Vector Contract) ---
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2
